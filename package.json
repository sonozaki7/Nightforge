{
  "name": "nightforge",
  "version": "0.1.0",
  "description": "Open-source autonomous software engineering orchestration platform",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/ --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "diagnostics": "tsx src/cli/diagnostics.ts",
    "setup": "tsx src/cli/setup-wizard.ts",
    "bench": "tsx src/cli/bench.ts"
  },
  "keywords": [
    "ai",
    "orchestration",
    "autonomous",
    "engineering",
    "kanban"
  ],
  "license": "MIT",
  "dependencies": {
    "bullmq": "^5.12.0",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "openai": "^4.73.0",
    "pino": "^9.5.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.0"
  }
}
