# Redis
REDIS_URL=redis://localhost:6379

# Linear
LINEAR_API_KEY=your-linear-api-key
LINEAR_WEBHOOK_SECRET=your-webhook-secret

# Model Providers
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3-235b-a22b
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Service Integrations (optional — tools disabled if empty)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
GOOGLE_ACCESS_TOKEN=your-google-oauth-access-token

# Self-hosted Services
CRAWL4AI_URL=http://localhost:11235
SEARXNG_URL=http://localhost:8080

# Paths
PROJECTS_DIR=/srv/apps
WORKTREES_DIR=/srv/nightforge/worktrees
# Project id tickets are routed to (directory under PROJECTS_DIR)
PROJECT_ID=nightforge

# GitHub — fine-grained PAT used to push merged code to origin and to check
# commit status before deploy (CI gate). Empty = gate skipped (local dev).
# Create at: github.com/settings/tokens → Generate new token → Fine-grained
# Required permissions (repository): Contents (R/W), Commit statuses (R), Actions (R)
GITHUB_TOKEN=your-github-fine-grained-pat

# ACP (Agent Client Protocol) — use existing Claude/Codex subscriptions
# Requires adapter binaries installed:
#   npm install -g @agentclientprotocol/claude-agent-acp
#   npm install -g @agentclientprotocol/codex-acp
ACP_ENABLED=false
ACP_DEFAULT_ADAPTER=claude
ACP_AUTO_APPROVE=false
ACP_SESSION_TIMEOUT_MINUTES=30

# Limits
MAX_CONCURRENT_WORKERS=6
MAX_DAILY_BUDGET_USD=50
MAX_AGENTIC_ITERATIONS=30

# Execution routing (autonomous — no label needed)
# autoRoute: true = tickets route to agentic/simple by complexity automatically
# agenticThreshold: minimum complexity score before the tool-use path is used
AUTO_ROUTE_EXECUTION_MODE=true
AGENTIC_THRESHOLD=3

# Sandbox (OS-level isolation for agent commands)
# mode: auto | docker | seatbelt | unsafe
#   auto     = pick Docker if available, else macOS Seatbelt, else unsafe
#   unsafe   = NO isolation — dev only, never on a production VPS
SANDBOX_MODE=auto
SANDBOX_DOCKER_IMAGE=node:22-alpine
SANDBOX_MEMORY_MB=1024
SANDBOX_CPUS=1
SANDBOX_NETWORK_ENABLED=false
SANDBOX_TIMEOUT_MS=300000

# Cost Ledger — Alibaba Token Plan Pro
# Find these at: https://modelstudio.console.alibabacloud.com → Token Plan → Usage
# Total token budget per month (weekly_quota / weekly_% * 4.33)
# Calibration: 222.3M (7/29+7/30) / 16.42% = 1.354B/week * 4.33 = 5.86B/month
ALIBABA_PLAN_TOKENS=5860000000
# Monthly base price in USD (before tax) — your Pro plan = $68
ALIBABA_PLAN_PRICE_USD=68
# Tokens already consumed (post-reset clean days only: 7/29 + 7/30 = 222.3M)
ALIBABA_BASELINE_USED_TOKENS=222300000
# Cached token weight: Alibaba's quota counts ALL tokens equally (cached = uncached)
ALIBABA_CACHED_TOKEN_WEIGHT=1.0
# Cache hit ratio from dashboard (reference/display only when weight=1.0)
ALIBABA_CACHE_HIT_RATIO=0.93

# Timezone
TIMEZONE=Asia/Bangkok

# Server
PORT=3000
HOST=0.0.0.0

# OpenCode — enable web search (Exa). Without this, opencode cannot do web research.
OPENCODE_ENABLE_EXA=1

# ─── Deployment (getnightforge.com landing page) ───────────────────────────
# SSH connection to your production server (tavia-new-prod)
# Format: user@host or user@host:port
DEPLOY_SSH=root@your-server-ip

# Cloudflare zone ID for getnightforge.com
# Find at: dash.cloudflare.com → getnightforge.com → Overview → right sidebar → Zone ID
CLOUDFLARE_ZONE_ID_GETNIGHTFORGE=your-zone-id-here

# Stripe — same key as STRIPE_API_KEY above, used by the setup script
# Get at: dashboard.stripe.com/apikeys → Reveal secret key
# Use sk_test_... for testing, sk_live_... for real payments
STRIPE_API_KEY=sk_test_your-stripe-secret-key
